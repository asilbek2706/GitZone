PORT=5000
NODE_ENV=development

CORS_ORIGIN="http://localhost:5173"

DATABASE_URL="postgresql://github_user:YOUR_PASSWORD@localhost:5432/github_clone"

JWT_ACCESS_SECRET="replace_with_a_random_secret_at_least_32_characters"
JWT_REFRESH_SECRET="replace_with_a_different_random_secret_at_least_32_characters"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

GIT_STORAGE_PATH="./storage/repositories"

BODY_LIMIT="1mb"

TRUST_PROXY="false"

TWO_FACTOR_ENCRYPTION_KEY="replace_with_64_hex_characters_generated_by_openssl_rand_hex_32"

# Git runtime
# Windows examples:
# GIT_EXECUTABLE_PATH="C:/Program Files/Git/cmd/git.exe"
# GIT_CHILD_PATH="C:/Program Files/Git/cmd;C:/Program Files/Git/mingw64/bin;C:/Program Files/Git/mingw64/libexec/git-core"
# GIT_HTTP_BACKEND_PATH="C:/Program Files/Git/mingw64/libexec/git-core/git-http-backend.exe"
GIT_EXECUTABLE_PATH="/usr/bin/git"
GIT_CHILD_PATH="/usr/bin:/bin"

# Git Smart HTTP
GIT_HTTP_BACKEND_PATH="/usr/lib/git-core/git-http-backend"
GIT_HTTP_MAX_HEADER_BYTES="16384"

# Repository Git data reads
GIT_READ_TIMEOUT_MS="5000"
GIT_READ_MAX_BUFFER_BYTES="5242880"
GIT_MAX_FILE_SIZE_BYTES="1048576"
