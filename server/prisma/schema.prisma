generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String  @id @default(cuid())
  username  String  @unique
  email     String  @unique
  password  String
  name      String?
  avatarUrl String?
  bio       String?

  sessions                 Session[]
  repositories             Repository[]
  personalAccessTokens     PersonalAccessToken[]
  repositoryCollaborations RepositoryCollaborator[]
  twoFactorAuthentication  TwoFactorAuthentication?
  recoveryCodes            RecoveryCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TwoFactorAuthentication {
  id              String    @id @default(cuid())
  userId          String    @unique
  encryptedSecret String
  enabledAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecoveryCode {
  id       String    @id @default(cuid())
  userId   String
  codeHash String
  usedAt   DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  refreshTokenJti  String    @unique
  tokenFamilyId    String
  parentSessionId  String?
  replacedById     String?   @unique
  userAgent        String?
  ipAddress        String?
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  rotatedAt        DateTime?
  reuseDetectedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentSession Session?  @relation("SessionRotation", fields: [parentSessionId], references: [id], onDelete: SetNull)
  childSessions Session[] @relation("SessionRotation")

  replacedBy      Session? @relation("SessionReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replacedSession Session? @relation("SessionReplacement")

  @@index([userId])
  @@index([expiresAt])
  @@index([tokenFamilyId])
  @@index([parentSessionId])
}

model PersonalAccessToken {
  id          String    @id @default(cuid())
  userId      String
  name        String
  tokenPrefix String    @unique
  tokenHash   String    @unique
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Repository {
  id            String  @id @default(cuid())
  ownerId       String
  name          String
  description   String?
  isPrivate     Boolean @default(false)
  defaultBranch String  @default("main")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  collaborators RepositoryCollaborator[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, name])
  @@index([ownerId])
}

enum RepositoryPermission {
  READ
  WRITE
}

model RepositoryCollaborator {
  id           String               @id @default(cuid())
  repositoryId String
  userId       String
  permission   RepositoryPermission @default(READ)

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([repositoryId, userId])
  @@index([repositoryId])
  @@index([userId])
}
